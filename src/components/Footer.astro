---
export interface FooterLink {
  label: string;
  href: string;
}

const links: FooterLink[] = [
  { label: 'Discord', href: 'https://discord.valleyrealm.qd.je' },
  { label: 'Terms of Service', href: '/legal/terms' },
  { label: 'Privacy Policy', href: '/legal/privacy' },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-row">
    <div class="footer-brand">
      <svg width="16" height="18" viewBox="0 0 18 20" fill="none">
        <path d="M9 0L17 3.5V9C17 14 13.5 18 9 20C4.5 18 1 14 1 9V3.5L9 0Z" stroke="#c8a132" stroke-width="1.3"/>
      </svg>
      ValleyRealm
    </div>
    <nav class="footer-links">
      {links.map((link) => (
        <a href={link.href} class="footer-link">{link.label}</a>
      ))}
    </nav>
  </div>
  <div class="wrap footer-note">
    &copy; {currentYear} ValleyRealm. All rights reserved.
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    padding: 44px 0 60px;
    position: relative;
    z-index: 1;
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "Cinzel", serif;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: 0.03em;
    color: var(--cream);
  }

  .footer-links {
    display: flex;
    gap: 24px;
    font-family: "Cinzel", serif;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--cream-faint);
  }

  .footer-link {
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--gold-bright);
  }

  .footer-note {
    margin-top: 18px;
    font-size: 0.88rem;
    font-style: italic;
    color: var(--cream-faint);
  }

  @media (max-width: 480px) {
    .footer { padding: 32px 0 40px; }
    .footer-row { justify-content: center; text-align: center; }
    .footer-links { gap: 16px; flex-wrap: wrap; justify-content: center; }
  }
</style>
